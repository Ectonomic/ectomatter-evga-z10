// EVGA Z10 RGB: the keyboard as Ectomatter draws and lights it.
// JSON with comments. Lengths are in millimeters, brightness in nits.
{
  "name": "EVGA Z10 RGB",
  // what sort of device it is, for Ectomatter's words about it (its lab: the Keyboard lab)
  "kind": "keyboard",
  "art": "art/z10.svg",
  // the part of the drawing the keyboard's page shows (x, y, width, height),
  // and the order its controls' groups are listed in (each control's "group")
  "view": [6, -2, 649, 260],
  "groups": ["Buttons", "Macro keys", "F-keys", "Number row", "Letters and symbols", "Modifiers and space", "Navigation", "Number pad"],

  // How the keys' legends are printed, for setting them anew from each
  // key's "print" (the Key lab's Legends section): the typeface they are
  // printed in, Orbitron from Ectomatter's own typefaces, the open look-alike
  // of the Z10's own Conthrax, which Ectomatter may not carry; the one for the
  // signs it lacks (in fonts/); the typeface the drawing's legends are drawn
  // in ("art", in fonts/), which Ectomatter sets anew, and the sizes it drew
  // them at, larger than the keyboard's own; signs the typeface
  // draws otherwise than the keys print them ("swap": Orbitron's zero is
  // slashed, its O is the plain zero); how tall a legend of one letter or
  // sign is and a legend of words (a capital's height, as measured on the
  // keyboard itself from TechPowerUp's photographs); how far down from
  // the top edge of a cap's top a one-letter legend starts; and the icons,
  // each drawn on a 24-unit square, "size" times as tall as its capitals
  // would be and "drop" times them below its line.
  "print": {
    "typeface": "Orbitron", "weight": 600, "symbols": "Z10 Symbols",
    "art": { "typeface": "Barlow Semi Condensed", "weight": 600, "letters": 3.786, "words": 2.568, "inset": 2.022 },
    "swap": { "0": "O" },
    "fonts": ["fonts/BarlowSemiCondensed-SemiBold.ttf", "fonts/Z10Symbols-Bold.ttf"],
    "letters": 2.8, "words": 1.9, "inset": 2.022,
    "icons": { "mute": { "fill": "M3 9h4l5-4v14l-5-4H3z", "stroke": "M16 9l6 6M22 9l-6 6", "width": 2, "size": 1.92, "drop": 0.15 } }
  },


  // Every key, button and roller. "id" names it everywhere else in this
  // file; "pos" is its place in the keyboard's own reports; "art" is its
  // piece in the drawing, control_<art>. A key's legend and light are the
  // drawing's legend_<100 + art> and illumination_<art>, <200 + art> and
  // <400 + art>. "lit": false is a key with no LED of its own. "box" is
  // where it sits on the keyboard's page (x, y, width, height, in the
  // drawing's units: EVGA's own editor's, its outline and where it's pressed),
  // "group" the heading it's listed under in the Key library, and "short"
  // the cap it has there. "molded": true is a button molded into the case,
  // with no cap of its own (the media buttons).
  // "print" is what its cap has printed on it, a part at a time: its own
  // legend, its shifted sign beside it ("shift") and its second function
  // at its foot ("second"), each its words or one of the icons above;
  // "scale" a sign printed larger than the rest. "centered": true is a key
  // whose legend sits in the middle of its cap.
