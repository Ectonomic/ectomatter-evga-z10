  // The display, and the glass over it: the drawing's screen_1 and overlay_1.
  "screens": [
    { "id": "display", "label": "Display", "art": 1 }
  ],

  // How the keys' light gets out, as Ectomatter works it out. The Key lab
  // (Ctrl+Shift+L) tunes it and saves it here.
  "light": {
    "scale": 1.38,       // the drawing's units to the millimeter
    "typical": "2",      // the key the Key lab draws for all keys

    "switches": {
      "kind": "led-slot",  // led-slot, clear-top or clear: the switch's housing
      "top": 5.7,          // the housing's top, above the deck
      "width": 12,
      "led": 5.08,         // the LED, north of the switch's middle (south below 0)
      "lumens": 1.056,     // the light each LED gives off at full white
      "beam": 3,           // how tight the LED's beam is: higher is tighter
      "scattered": 0.85,   // a clear housing: the share of the light it scatters,
      "sides": 0.5,        //   the share of that out of its sides,
      "glow": 6,            //   and how far its glow carries
      "bleed": 0.35
    },

    "caps": {
      "kind": "shine-through",  // shine-through, pudding or translucent
      "foot": 5,                // the skirt's foot and the cap's top, above the deck
      "top": 14,
      "opacity": 0.8,           // the walls' opacity, on pudding and translucent caps: 0 lets the light through, 1 is opaque
      "black": 0.4,             // how far down the sides the top's black comes, on pudding caps
      "milky": 0.8,             // how milky the plastic is (the lab's Haze), 0 clear to 1 milky white
      "inside": 0.2,            // the shares of light the caps' insides and outsides reflect
      "outside": 0.6
    },

    // the legends: how much of the light behind them they hold back, 0 clear to
    // 1 as dark as the cap's black; and with their LED off, their share of the drawing's gray
    "legends": { "opacity": 0.7, "unlit": 0.5 },

    "wells": {
      "art": "mask_1",  // the drawing's piece that holds them
      "depth": 2,
      "deck": 0.22,     // the shares of light the deck and the chassis reflect
      "chassis": 0.4
    },

    // the display: its dots lit and unlit and the ground between them, how
    // much of its cell a dot fills, and how strongly the glass shows its sheen
    "display": { "lit": 45, "unlit": 1, "background": 2, "dot": 0.84, "glass": 1, "bleed": 0.2 },

    // keys set apart from the rest, only what differs ("place" is where a
    // key's switch sits under its cap, mm east and north of its middle): the
    // buttons stand on the chassis, opaque, as high as EVGA's photos show them
    "keys": {
      "print-screen": { "legends": { "words": 1.5 } },
      "scroll-lock": { "legends": { "words": 1.5 } },
      "pause": { "legends": { "words": 1.5 } },
      "insert": { "legends": { "words": 1.5 } },
      "home": { "legends": { "words": 1.5 } },
      "page-up": { "legends": { "words": 1.5 } },
      "num-lock": { "legends": { "words": 1.5 } },
      "delete": { "legends": { "words": 1.5 } },
      "end": { "legends": { "words": 1.5 } },
      "page-down": { "legends": { "words": 1.5 } },
      "keypad-7": { "legends": { "words": 1.5 } },
      "keypad-9": { "legends": { "words": 1.5 } },
      "keypad-1": { "legends": { "words": 1.5 } },
      "keypad-3": { "legends": { "words": 1.5 } },
      "keypad-0": { "legends": { "words": 1.5 } },
      "keypad-dot": { "legends": { "words": 1.5 } },
      "gpc":      { "caps": { "kind": "shine-through", "foot": 2, "top": 3 } },
      "stop":     { "caps": { "kind": "shine-through", "foot": 2, "top": 6 } },
      "previous": { "caps": { "kind": "shine-through", "foot": 2, "top": 6 } },
      "play":     { "caps": { "kind": "shine-through", "foot": 2, "top": 6 } },
      "next":     { "caps": { "kind": "shine-through", "foot": 2, "top": 6 } },
      "keypad-plus": { "place": { "north": 4.5 }, "legends": { "place": "middle" } },
      "keypad-enter": { "place": { "north": 4.5 } },
      "space": { "caps": { "kind": "shine-through" } },
      "backslash": { "legends": { "main": "|", "shift": "", "second": "\\" } },
      "right-bracket": { "legends": { "shift": "", "main": "}", "second": "]" } },
      "left-bracket": { "legends": { "main": "{", "shift": "", "second": "[" } },
      "semicolon": { "legends": { "second": ";", "shift": "", "main": ":" } },
      "quote": { "legends": { "main": "\"", "second": "'", "shift": "" } },
      "slash": { "legends": { "main": "?", "shift": "", "second": "/" } },
      "period": { "legends": { "main": ">", "second": ".", "shift": "" } },
      "comma": { "legends": { "main": "<", "shift": "", "second": "," } },
      "minus": { "legends": { "shift": "-", "main": "_" } },
      "equals": { "legends": { "main": "+", "shift": "=" } },
      "grave": { "legends": { "main": "~", "shift": "`" } },
      "f1": { "legends": { "second": "🔇" } },
      "right-shift": { "legends": { "second": "SHIFT", "main": "⇧", "down": -1.5, "words": 2.1 } },
      "left-shift": { "legends": { "second": "SHIFT", "main": "⇧", "down": -1.5, "words": 2.1 } },
      "tab": { "legends": { "second": "TAB", "main": "↹", "down": -1 } },
      "e1": { "legends": { "words": 2.8 } },
      "e2": { "legends": { "words": 2.8 } },
      "e3": { "legends": { "words": 2.8 } },
      "e4": { "legends": { "words": 2.8 } },
      "e5": { "legends": { "words": 2.8 } },
      "caps-lock": { "legends": { "words": 2.3, "place": "middle", "down": 0.5 } },
      "esc": { "legends": { "words": 2.15 } }
    }
  },

  // The lock lights over the numpad, the drawing's pieces named here: dark
  // until the keyboard's own lock light is on, then lit in their color,
  // brightest over the LED and a little light out of the window's edges.
  "lock_lights": {
    "num": "num-lock-light", "caps": "caps-lock-light", "scroll": "scroll-lock-light",
    "color": "#ff6000",
    "brightness": 300,
    "spread": 1.45,  // how far from the LED the window stays bright
    "floor": 0.5,    // how lit the window's corners stay
    "spill": { "brightness": 6, "reach": 0.72 }
  }
}
